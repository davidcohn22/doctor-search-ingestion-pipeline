# Copy to .env and fill in. NEVER commit .env — it is git-ignored.
#   cp .env.example .env
#   git check-ignore -v .env      # must print a .gitignore line before you add secrets

# ---------------------------------------------------------------------------
# Required by every bucket
# ---------------------------------------------------------------------------

# Postgres connection for the ingestion role (read/write on public + staging).
# Password is whatever you set in the docs repo's ddl/08-roles-and-grants.sql.
DATABASE_URL=postgresql://pex_ingest:CHANGEME@localhost:5432/pex

# Absolute path to the raw-file landing tree, OUTSIDE both git repos.
# Create it with: mkdir -p ~/pex-data/{nppes,cms-dac,openalex/{authors,works},ctgov,mesh,nucc,geocode,_archive}
PEX_DATA_DIR=/Users/dcohn/pex-data

# Sent as the HTTP User-Agent on every outbound request. Several agencies ask
# for a contact address and throttle anonymous traffic harder without one.
CONTACT_EMAIL=you@example.com

# ---------------------------------------------------------------------------
# Bucket 3 — Publications
# ---------------------------------------------------------------------------

# Free, instant: https://account.ncbi.nlm.nih.gov/settings/ -> API Key Management
# Raises PubMed E-utilities from 3 to 10 requests/sec.
NCBI_API_KEY=
NCBI_EMAIL=you@example.com

# Free tier: https://openalex.org/pricing
# ONLY needed for the REST API path. The bulk snapshot path needs no key and no
# AWS account — see docs/decisions/0001-openalex-works-via-snapshot.md
OPENALEX_API_KEY=

# ---------------------------------------------------------------------------
# Bucket 5 — Condition vocabulary  (the only bucket that spends money)
# ---------------------------------------------------------------------------

# https://platform.claude.com -> API keys. Costs single-digit dollars via the
# Batches API. Read by the SDK's zero-arg constructor: anthropic.Anthropic()
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Buckets 1, 2, 4 need no credentials at all.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Optional tuning. Every one of these has a sane default; set them only when a
# machine or a particular run needs something different.
# ---------------------------------------------------------------------------

# Cache HTTP responses under $PEX_DATA_DIR/_cache. On by default, which makes
# re-runs during development effectively free. Set to 0 for a fully live run.
# PEX_HTTP_CACHE=1

# Rows per upsert batch. Larger is faster and holds more in memory.
# PEX_BATCH_SIZE=5000

# DEBUG, INFO, WARNING. INFO is what the run summaries are written at.
# PEX_LOG_LEVEL=INFO
